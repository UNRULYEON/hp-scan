{
  "name": "hp-scan-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "build:mac-arm": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile dist/hp-scan-helper-mac-arm64",
    "build:mac-x64": "bun build --compile --target=bun-darwin-x64 src/index.ts --outfile dist/hp-scan-helper-mac-x64",
    "build:win": "bun build --compile --target=bun-windows-x64 src/index.ts --outfile dist/hp-scan-helper-win-x64.exe",
    "build": "bun run build:mac-arm && bun run build:mac-x64 && bun run build:win"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1"
  }
}
